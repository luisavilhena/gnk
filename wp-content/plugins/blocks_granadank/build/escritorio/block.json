{
  "apiVersion": 2,
  "name": "blocks/escritorio",
  "title": "Bloco Escritório",
  "category": "widgets",
  "icon": "building",
  "description": "Bloco com subtítulo, título, descrição e link editável para destacar informações do escritório.",
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "supports": {
    "html": false
  },
  "attributes": {
    "subtitulo": {
      "type": "string",
      "source": "html",
      "selector": "h4",
      "default": ""
    },
    "titulo": {
      "type": "string",
      "source": "html",
      "selector": "h2",
      "default": ""
    },
    "descricao": {
      "type": "string",
      "source": "html",
      "selector": "p",
      "default": ""
    },
    "link": {
      "type": "string",
      "default": ""
    },
    "linkTexto": {
      "type": "string",
      "source": "html",
      "selector": "a",
      "default": "Saiba mais"
    }
  }
}